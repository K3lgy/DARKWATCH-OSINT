# ─────────────────────────────────────────────────────────────
# DARKWATCH OSINT Platform — Configuration d'environnement
# Copiez ce fichier en .env et remplissez les valeurs
# NE JAMAIS committer le fichier .env dans le dépôt
# ─────────────────────────────────────────────────────────────

# ─── Tor ─────────────────────────────────────────────────────
TOR_SOCKS_HOST=127.0.0.1
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
TOR_CONTROL_PASSWORD=changeme_strong_password

# ─── Base de données PostgreSQL ──────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=darkwatch
DB_USER=osint_user
DB_PASS=changeme_strong_password
DB_SSL_MODE=require

# ─── Elasticsearch ───────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX_PREFIX=darkwatch_
# ELASTICSEARCH_USERNAME=elastic
# ELASTICSEARCH_PASSWORD=changeme

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ─── Rotation de circuit automatique ─────────────────────────
# Intervalle en secondes (600 = 10 minutes)
CIRCUIT_ROTATION_INTERVAL=600

# ─── Crawl ───────────────────────────────────────────────────
# Délai max par requête .onion (secondes)
REQUEST_TIMEOUT=30
# Délai entre requêtes (politesse)
CRAWL_DELAY=2
# Profondeur de crawl par défaut
DEFAULT_CRAWL_DEPTH=2
# User-agent
CRAWL_USER_AGENT=DarkwatchBot/2.4 (defensive OSINT research)

# ─── Alertes ─────────────────────────────────────────────────
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_FROM=darkwatch@votre-domaine.com
ALERT_EMAIL_TO=soc@votre-domaine.com
SMTP_HOST=smtp.votre-domaine.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXXX/YYYY/ZZZZ

# ─── API ─────────────────────────────────────────────────────
API_PORT=8080
API_SECRET_KEY=changeme_very_long_random_secret_key_here
JWT_EXPIRY=3600
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# ─── Environnement ───────────────────────────────────────────
# development | production
APP_ENV=development
LOG_LEVEL=INFO

# ─── AI Analyst ──────────────────────────────────────────────
# Modèle Ollama à utiliser (mistral | llama3 | qwen2.5)
OLLAMA_MODEL=mistral
# URL Ollama (laisser par défaut si Docker Compose)
OLLAMA_URL=http://ollama:11434
# Timeout LLM en secondes
LLM_TIMEOUT=120
